    "webpack-dev-server": "^4.7.4"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "css-loader": "^6.9.0",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4"
  }
